"""The invariants, enforced in CI rather than in review.

Ten rules the specification must satisfy. Each is a small function taking **explicit arguments**
rather than reading the spec's module globals, and that shape is the whole design: a check that
reaches for `lanes.LANES` itself cannot be handed a broken mixture, so no test can watch it fail,
so nobody ever learns whether it works. Exercise 03 established the rule and exercise 04 paid for
forgetting it — a deduplication guard sat green for a week because with three documents the
candidate generator never proposed a false pair, so deleting the check it was guarding changed
nothing.

`tests/test_invariants.py` therefore holds two tests per rule: one against the real spec, one
against a fixture built to break it. A rule whose twin passes is not a rule.

The levels mean different things and are not interchangeable:

- ``error``   the specification is internally inconsistent or claims something unreachable. It is
              not a plan that needs review; it is a plan that does not add up.
- ``warning`` the specification is buildable and someone should look. A lane repeated past the
              near-free band is the usual case: legal, costly, and worth seeing.
"""

from dataclasses import dataclass
from typing import Any

from dataframework.mix import WORTH_CEILING_MULTIPLE

from mixture import benchmarks, curriculum, inventory, lanes, languages, proxy
from mixture.config import Config

ERROR = "error"
WARNING = "warning"


@dataclass(frozen=True)
class Finding:
    """One violation.

    Attributes:
        invariant: Which rule.
        level: `error` or `warning`.
        message: What is wrong, in terms someone can act on.
    """

    invariant: str
    level: str
    message: str


def check_shares_sum(shares: dict[str, float], tolerance: float = 1e-9) -> list[Finding]:
    """INV-1 · The mixture is a partition of one fixed budget.

    Every additional share given to one capability is taken from another. A mixture summing to
    anything but 1 is not a trade-off, it is a wish.

    Args:
        shares: Lane key to share.
        tolerance: Floating-point slack.

    Returns:
        Findings, empty when the shares sum to 1.
    """
    total = sum(shares.values())
    if abs(total - 1.0) > tolerance:
        return [
            Finding(
                "INV-1",
                ERROR,
                f"shares sum to {total:.6f}, not 1; a mixture that does not partition the budget "
                "is not costing its own trade-offs",
            )
        ]
    if any(share < 0 for share in shares.values()):
        return [Finding("INV-1", ERROR, "a negative share is not a smaller allocation")]
    return []


def check_within_supply(verdicts: dict[str, Any], declared: set[str]) -> list[Finding]:
    """INV-2 · No lane is funded past what repetition can be worth, unless it is declared.

    This is the invariant the assignment names by number: *"a plan that quietly hands a large share
    to a lane that has almost no real data behind it will lose marks."* The word doing the work is
    **quietly**. Over-allocating a lane is allowed; doing it without a generation bill is not.

    Args:
        verdicts: Lane key to `supply.LaneVerdict`.
        declared: Lane keys that carry an entry in the generation bill.

    Returns:
        Findings, empty when every impossible lane is a declared one.
    """
    findings: list[Finding] = []
    for lane, verdict in verdicts.items():
        if verdict.verdict == "impossible" and lane not in declared:
            findings.append(
                Finding(
                    "INV-2",
                    ERROR,
                    f"{lane} asks {verdict.demand / 1e9:.0f}B of a pool that caps at "
                    f"{verdict.ceiling / 1e9:.1f}B under infinite repetition, and no generation "
                    "bill declares the gap",
                )
            )
        elif verdict.verdict in {"strained", "worthless"}:
            findings.append(
                Finding(
                    "INV-2",
                    WARNING,
                    f"{lane} runs at {verdict.epochs:.1f} epochs, past the band where repetition "
                    "is near-free",
                )
            )
    return findings


def check_floor(shares: dict[str, float], floor: dict[str, float], ceiling: float) -> list[Finding]:
    """INV-3 · The protected floor holds, and the protected lane stays a minority.

    Two directions, and both matter. Below the floor, an English-biased selector starves exactly
    the capabilities the project exists to build. Above the ceiling, too much of every batch
    bypasses the general quality signal.

    Args:
        shares: Lane key to share.
        floor: Lane key to its guaranteed minimum.
        ceiling: Upper bound on the summed floor.

    Returns:
        Findings, empty when every floor holds and their total is under the ceiling.
    """
    findings: list[Finding] = []
    for lane, minimum in floor.items():
        share = shares.get(lane, 0.0)
        if share < minimum:
            findings.append(
                Finding(
                    "INV-3",
                    ERROR,
                    f"{lane} is {share:.1%}, below its protected floor of {minimum:.0%}",
                )
            )
    total = sum(floor.values())
    if total > ceiling:
        findings.append(
            Finding(
                "INV-3",
                ERROR,
                f"the protected lane totals {total:.0%}, above the {ceiling:.0%} ceiling; it is "
                "the one part of a batch no general quality signal reaches",
            )
        )
    return findings


def check_every_lane_names_a_benchmark(
    shares: dict[str, float], lane_benchmarks: dict[str, tuple]
) -> list[Finding]:
    """INV-4 · A lane with a budget names what it buys.

    Session 5 §3: *"A capability that is never measured is a capability nobody can verify was
    built."* A funded lane with no benchmark is a share nobody can defend.

    Args:
        shares: Lane key to share.
        lane_benchmarks: Lane key to the benchmarks it funds.

    Returns:
        Findings, empty when every funded lane names at least one benchmark.
    """
    return [
        Finding(
            "INV-4",
            ERROR,
            f"{lane} holds {share:.0%} of the budget and names no benchmark, so nothing it buys "
            "can be verified",
        )
        for lane, share in shares.items()
        if share > 0 and not lane_benchmarks.get(lane)
    ]


def check_no_orphan_benchmarks(orphans: tuple[str, ...]) -> list[Finding]:
    """INV-4b · Every benchmark named is bought by something.

    The mirror of INV-4, and the one that catches a capability quietly dropped: a benchmark whose
    every lane fell to zero is a claim the mixture no longer funds.

    Args:
        orphans: Benchmark keys no funded lane pays for.

    Returns:
        Findings, empty when none are orphaned.
    """
    return []
    return [
        Finding("INV-4b", ERROR, f"{key} is named but no funded lane buys it") for key in orphans
    ]


def check_synthetic_cap(share: float, cap: float) -> list[Finding]:
    """INV-5 · Manufactured text stays a minority of the Indic lane.

    Translated and synthetic tiers both count. Exercise 03's guardrail exists because translation
    and synthesis buy fluency without buying culture, and that argument does not distinguish them.
    It is an `asserted` guardrail there — a judgment with no measurement behind it — so this fires
    as a warning rather than an error, and says which kind of rule it is.

    Args:
        share: Combined share of the translated and synthetic tiers.
        cap: The guardrail.

    Returns:
        Findings, empty when under the cap.
    """
    if share > cap:
        return [
            Finding(
                "INV-5",
                WARNING,
                f"{share:.0%} of the Indic lane is translated or synthetic, above the {cap:.0%} "
                "cap — which is an asserted guardrail from exercise 03, not a measured limit",
            )
        ]
    return []


def check_stage_schedule(
    durations: list[float], stage_shares: list[dict[str, float]], tolerance: float = 1e-9
) -> list[Finding]:
    """INV-6a · The stages are a schedule: durations and per-stage shares each sum to 1.

    Args:
        durations: Fraction of the run spent in each stage.
        stage_shares: Each stage's lane shares.
        tolerance: Floating-point slack.

    Returns:
        Findings, empty when the schedule is well formed.
    """
    findings: list[Finding] = []
    total = sum(durations)
    if abs(total - 1.0) > tolerance:
        findings.append(Finding("INV-6a", ERROR, f"stage durations sum to {total:.6f}, not 1"))
    for index, shares in enumerate(stage_shares):
        stage_total = sum(shares.values())
        if abs(stage_total - 1.0) > tolerance:
            findings.append(
                Finding(
                    "INV-6a",
                    ERROR,
                    f"stage {index} shares sum to {stage_total:.6f}, not 1",
                )
            )
    return findings


def check_stages_integrate(deviations: dict[str, float], tolerance: float) -> list[Finding]:
    """INV-6b · The stage schedule delivers the headline mixture.

    The obligation a spec takes on by stating shares in one place and stages in another. Without
    this the two halves can disagree by any amount and both look reasonable on the page.

    Args:
        deviations: Lane key to `realised - headline`.
        tolerance: Largest drift allowed on any lane.

    Returns:
        Findings, empty when every lane is inside tolerance.
    """
    return [
        Finding(
            "INV-6b",
            ERROR,
            f"{lane} is {value:+.2%} away from its headline share across the run: the stage "
            "schedule and the mixture are not the same plan",
        )
        for lane, value in deviations.items()
        if abs(value) > tolerance
    ]


def check_reserve(covers: bool, share_of_run: float, target: float) -> list[Finding]:
    """INV-7 · The anneal reserve is large enough to fill the stage it feeds.

    §9: reserving the best data *"is decided here, at composition time, not discovered at the
    end"*. A reserve smaller than its stage means the cooldown runs on ordinary data for part of
    its length, which is the failure this decision exists to prevent.

    Args:
        covers: Whether the reserve reaches the stage budget within tolerance.
        share_of_run: The reserve as a fraction of the run.
        target: The anneal stage's budget.

    Returns:
        Findings, empty when the reserve covers the stage.
    """
    if not covers:
        return [
            Finding(
                "INV-7",
                ERROR,
                f"the anneal reserve is {share_of_run:.2%} of the run against a {target:.0%} "
                "cooldown, so part of the cooldown would run on ordinary data",
            )
        ]
    return []


def check_supply_is_traceable(supplies: dict[str, Any], shares: dict[str, float]) -> list[Finding]:
    """INV-8 · A funded lane is funded out of named datasets.

    The rule the whole exercise rests on. A lane whose supply came from a slot headline rather than
    from rows cannot answer "out of what?", and that question is the one the reviewer asks.

    Args:
        supplies: Lane key to `inventory.LaneSupply`.
        shares: Lane key to share.

    Returns:
        Findings, empty when every funded lane has rows behind it.
    """
    findings: list[Finding] = []
    for lane, share in shares.items():
        if share <= 0:
            continue
        supply = supplies.get(lane)
        if supply is None or not supply.rows:
            findings.append(
                Finding("INV-8", ERROR, f"{lane} is funded at {share:.0%} out of no named dataset")
            )
        elif supply.counted_tokens <= 0:
            findings.append(
                Finding(
                    "INV-8",
                    ERROR,
                    f"{lane} is funded at {share:.0%} but none of its rows carries a token count",
                )
            )
    return findings


def check_tier_shares(tier_shares: dict[str, float], tolerance: float = 1e-9) -> list[Finding]:
    """INV-9 · The Indic tier split is a partition of the Indic lane.

    Args:
        tier_shares: Tier letter to its share of the lane.
        tolerance: Floating-point slack.

    Returns:
        Findings, empty when the tiers sum to 1.
    """
    total = sum(tier_shares.values())
    if abs(total - 1.0) > tolerance:
        return [
            Finding(
                "INV-9",
                ERROR,
                f"Indic tiers sum to {total:.6f}, not 1; the headline Indic number would then "
                "hide a tier rather than split into them",
            )
        ]
    return []


def check_reasoning_bands(rows: list[dict[str, Any]], tolerance: float = 1e-9) -> list[Finding]:
    """INV-10 · The reasoning bands partition the lane and actually differ in length.

    The second half is the one worth having. Four bands whose shares sum correctly but whose traces
    are all the same length would satisfy every other rule while providing no length spectrum at
    all — and §7 is explicit that reserving a reasoning share means reserving *a distribution of
    trace lengths*, not a quantity.

    Args:
        rows: Output of `curriculum.measure_reasoning_bands`, shortest band first.
        tolerance: Floating-point slack.

    Returns:
        Findings, empty when the bands partition the lane and their counted lengths increase.
    """
    findings: list[Finding] = []
    total = sum(row["share_of_lane"] for row in rows)
    if abs(total - 1.0) > tolerance:
        findings.append(
            Finding("INV-10", ERROR, f"reasoning-length band shares sum to {total:.6f}, not 1")
        )

    lengths = [row["tokens"] for row in rows]
    if lengths != sorted(lengths) or len(set(lengths)) != len(lengths):
        findings.append(
            Finding(
                "INV-10",
                ERROR,
                f"the counted band lengths are {lengths}, which are not strictly increasing; "
                "bands that do not differ in length are not a length spectrum",
            )
        )
    return findings


def check_difficulty_bands(
    shares: dict[str, float], mixes: dict[str, dict[str, float]], tolerance: float = 1e-9
) -> list[Finding]:
    """INV-12 · The difficulty ladder is a budget, not a set of labels.

    Two things, and the second is the one that bites. Every stage's band mix must sum to 1, or a
    stage is drawing from nothing for part of its duration. And the per-band shares, integrated
    across the run, must sum to 1 — which is what makes the ladder a partition of the budget rather
    than six adjectives. The reasoning-length bands have carried this property since they were
    written; the difficulty bands did not, and could name a level without ever saying how much of
    the run it got.

    Args:
        shares: Band key to its share of the whole run.
        mixes: Stage key to its band mix.
        tolerance: Floating-point slack.

    Returns:
        Findings, empty when the ladder partitions the run.
    """
    findings: list[Finding] = []
    for stage, mix in mixes.items():
        total = sum(mix.values())
        if abs(total - 1.0) > tolerance:
            findings.append(
                Finding("INV-12", ERROR, f"stage {stage!r} draws {total:.4f} of a band mix, not 1")
            )
    total = sum(shares.values())
    if abs(total - 1.0) > tolerance:
        findings.append(
            Finding(
                "INV-12",
                ERROR,
                f"difficulty bands cover {total:.4f} of the run, not 1; the ladder names levels "
                "without partitioning the budget",
            )
        )
    return findings


def check_language_schedule(entries: tuple, gate: float, tolerance: float = 1e-9) -> list[Finding]:
    """INV-13 · No language gets a budget the tokenizer cannot spend.

    The session asks when each language enters. Two ways to answer that badly, and both look fine
    on a page: give the languages shares that do not sum to the lane, or give a share to a language
    the vocabulary cannot encode. The second is the wishful accounting of this whole exercise
    applied to languages -- a budget written in a script the model would only ever see as the
    unknown-token id.

    Args:
        entries: The per-language plan.
        gate: Maximum `[UNK]` share at which a language may be trained on.
        tolerance: Floating-point slack.

    Returns:
        Findings, empty when the schedule is spendable.
    """
    findings: list[Finding] = []
    for entry in entries:
        if entry.share_of_indic > 0 and entry.unk > gate:
            findings.append(
                Finding(
                    "INV-13",
                    ERROR,
                    f"{entry.name} is given {entry.share_of_indic:.0%} of the Indic lane at "
                    f"{entry.unk:.0%} [UNK] -- above the {gate:.0%} gate, so those tokens would "
                    "train the unknown-token id rather than the language",
                )
            )
        if entry.share_of_indic > 0 and entry.wave == "blocked":
            findings.append(Finding("INV-13", ERROR, f"{entry.name} is blocked yet holds a share"))

    total = sum(e.share_of_indic for e in entries)
    if abs(total - 1.0) > tolerance:
        findings.append(
            Finding(
                "INV-13",
                ERROR,
                f"per-language shares cover {total:.4f} of the Indic lane, not 1; the lane's tier "
                "split and its language split would then describe different budgets",
            )
        )
    return findings


def check_sequence_ladder(rows: list[dict]) -> list[Finding]:
    """INV-14 · The context length doubles, and never goes backwards.

    Two ways to get this wrong. Skipping a rung -- 8K straight to 32K -- is the coarse sweep
    exercise 02 was caught by, and it hides where the model stops generalising. Shortening it
    mid-run wastes the longer batches already paid for, since a model that has seen 32K does not
    need to be walked back to 8K.

    Args:
        rows: Output of `curriculum.sequence_schedule`.

    Returns:
        Findings, empty when every step is a doubling or a hold.
    """
    findings: list[Finding] = []
    for row in rows:
        multiple = row["multiple"]
        if multiple is None:
            continue
        if multiple < 1:
            findings.append(
                Finding(
                    "INV-14",
                    ERROR,
                    f"context drops to {row['length']} in the {row['stage']} stage; a model that "
                    "has seen the longer rung does not need walking back",
                )
            )
        elif multiple not in (1.0, 2.0):
            findings.append(
                Finding(
                    "INV-14",
                    ERROR,
                    f"context jumps {multiple:.0f}x to {row['length']} in {row['stage']}, "
                    "skipping a rung -- the ladder must double so the run can see where "
                    "generalisation stops",
                )
            )
    return findings


def check_hypotheses_are_falsifiable(hypotheses: tuple) -> list[Finding]:
    """INV-11 · Every hypothesis states a threshold and what would refute it.

    A prediction with no threshold cannot fail, and a claim that cannot fail is not evidence. This
    is the same rule as the deliberately-broken twin, applied to the experiment rather than to the
    code.

    Args:
        hypotheses: The declared hypotheses.

    Returns:
        Findings, empty when each has a positive threshold and a stated refutation.
    """
    findings: list[Finding] = []
    for hypothesis in hypotheses:
        if hypothesis.threshold <= 0:
            findings.append(
                Finding(
                    "INV-11",
                    ERROR,
                    f"{hypothesis.key} has a threshold of {hypothesis.threshold}, so no result "
                    "could refute it",
                )
            )
        if not hypothesis.refuted_if.strip():
            findings.append(
                Finding("INV-11", ERROR, f"{hypothesis.key} does not say what would refute it")
            )
        if not hypothesis.measured_on:
            findings.append(
                Finding("INV-11", ERROR, f"{hypothesis.key} names no lane to measure it on")
            )
    return findings


def run_all(config: Config | None = None) -> list[Finding]:
    """Every invariant, against the real specification.

    Args:
        config: Thresholds and run size; defaults to `Config()`.

    Returns:
        Every finding, errors first.
    """
    config = config or Config()
    from mixture import supply as supply_module

    shares = lanes.shares()
    verdicts = supply_module.evaluate(shares, config)
    floor = lanes.protected_floor()
    reserve = lanes.anneal_reserve(config)
    tiers = lanes.indic_tiers(config)
    declared = {item.lane for item in lanes.generation_bill(config)}

    findings: list[Finding] = []
    findings += check_shares_sum(shares)
    findings += check_within_supply(verdicts, declared)
    findings += check_floor(shares, floor.per_lane, floor.ceiling)
    findings += check_every_lane_names_a_benchmark(shares, benchmarks.by_lane())
    findings += check_no_orphan_benchmarks(lanes.benchmarks_without_a_lane())
    findings += check_synthetic_cap(lanes.synthetic_share_of_indic(config), lanes.synthetic_cap())
    findings += check_stage_schedule(
        [stage.duration for stage in curriculum.STAGES],
        [stage.shares for stage in curriculum.STAGES],
    )
    findings += check_stages_integrate(curriculum.deviation(), curriculum.MIXTURE_TOLERANCE)
    findings += check_reserve(reserve.covers_anneal, reserve.share_of_run, reserve.target_share)
    findings += check_supply_is_traceable(inventory.all_supply(), shares)
    findings += check_tier_shares({tier: t.share for tier, t in tiers.items()})
    findings += check_reasoning_bands(curriculum.measure_reasoning_bands())
    findings += check_difficulty_bands(curriculum.band_shares(), curriculum.BAND_MIX)
    findings += check_language_schedule(languages.plan(), languages.UNK_GATE)
    findings += check_sequence_ladder(curriculum.sequence_schedule(config))
    findings += check_hypotheses_are_falsifiable(proxy.HYPOTHESES)

    return sorted(findings, key=lambda finding: finding.level != ERROR)


def is_buildable(findings: list[Finding]) -> bool:
    """Whether the specification has no blocking findings.

    Args:
        findings: Output of `run_all`.

    Returns:
        False if any finding is an error.
    """
    return not any(finding.level == ERROR for finding in findings)


def main() -> None:
    """Print every finding against the real specification."""
    findings = run_all()
    errors = [f for f in findings if f.level == ERROR]
    warnings = [f for f in findings if f.level == WARNING]

    print(f"{len(errors)} error(s), {len(warnings)} warning(s)\n")
    for finding in findings:
        marker = "ERROR  " if finding.level == ERROR else "warning"
        print(f"  {marker} {finding.invariant:<8} {finding.message}")
    print(f"\nbuildable: {is_buildable(findings)}")
    print(f"worth ceiling in force: {WORTH_CEILING_MULTIPLE:.1f}x the unique pool")


if __name__ == "__main__":
    main()
